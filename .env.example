MONGODB_URI=mongodb://localhost:27017/officecli_saas
JWT_SECRET=replace-with-at-least-32-random-characters
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
STORAGE_DIR=./storage
NEXT_PUBLIC_SITE_URL=https://your-production-domain.example

# The administrator is created automatically on a new database. If the
# password is empty, a strong one-time password is printed in startup logs.
ADMIN_EMAIL=sino_miles@foxmail.com
ADMIN_PASSWORD=

# Run `npm run prepare:aioncore` during build/deployment. AIONCORE_BIN can
# override the managed runtime path; AIONCORE_MANAGED=0 uses an external core.
AIONCORE_VERSION=v0.1.44
AIONCORE_BIN=
AIONCORE_URL=http://127.0.0.1:9123
AIONCORE_PORT=9123
AIONCORE_MANAGED=1
AIONCORE_DATA_DIR=
AIONCORE_WORK_DIR=
AIONCORE_LOG_DIR=

# WeChat Pay API v3 (Native QR payment). Private/public keys may be PEM text
# with escaped newlines or base64-encoded PEM. Never expose these as NEXT_PUBLIC_*.
WECHAT_PAY_APP_ID=wx0541b3e2a6d9dff7
WECHAT_PAY_MCH_ID=1682009029
WECHAT_PAY_CERT_SERIAL_NO=7686104869A1CBAF85487AE2F8968759ECD53574
WECHAT_PAY_PRIVATE_KEY=
# Prefer an absolute server-side file path over embedding private key contents.
WECHAT_PAY_PRIVATE_KEY_FILE=/run/secrets/wechat-pay/apiclient_key.pem
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PLATFORM_PUBLIC_KEY=
WECHAT_PAY_PLATFORM_PUBLIC_KEY_FILE=./config/wechat-pay/wechatpay_public_key.pem
WECHAT_PAY_PLATFORM_SERIAL_NO=PUB_KEY_ID_0116820090292026071500182322000004
WECHAT_PAY_NOTIFY_URL=https://your-production-domain.example/api/payments/wechat/notify
