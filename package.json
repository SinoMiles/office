{
  "name": "web-app",
  "version": "0.1.0",
  "private": true,
  "aioncoreVersion": "v0.1.52",
  "scripts": {
    "prepare:aioncore": "node scripts/prepare-aioncore.mjs",
    "infra:up": "docker compose up -d mongo gotenberg",
    "infra:down": "docker compose stop mongo gotenberg",
    "dev": "node scripts/run-server.mjs development",
    "build": "next build",
    "start": "node scripts/run-server.mjs production",
    "dev:docker": "docker compose --profile container-web up -d --build web",
    "lint": "eslint",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@officecli/sdk": "^0.1.2",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "duck-duck-scrape": "^2.2.7",
    "googlethis": "^1.8.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.23.0",
    "mammoth": "^1.12.0",
    "mongoose": "^9.7.4",
    "next": "16.2.10",
    "nodemailer": "^9.0.3",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hot-toast": "^2.6.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "ws": "^8.21.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.10"
  }
