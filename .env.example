MONGODB_URI=mongodb://127.0.0.1:27017/officecli_saas?replicaSet=rs0
JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_CODE_SECRET=replace-with-a-separate-random-secret
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
STORAGE_DIR=./storage
NEXT_PUBLIC_SITE_URL=https://your-production-domain.example

# The administrator is created automatically on a new database. If the
# password is empty, a strong one-time password is printed in startup logs.
ADMIN_EMAIL=sino_miles@foxmail.com
ADMIN_PASSWORD=

# Run `npm run prepare:aioncore` during build/deployment. AIONCORE_BIN can
# override the managed runtime path; AIONCORE_MANAGED=0 uses an external core.
AIONCORE_VERSION=v0.1.52
AIONCORE_BIN=
AIONCORE_URL=http://127.0.0.1:9123
AIONCORE_PORT=9123
AIONCORE_MANAGED=1
AIONCORE_DATA_DIR=
AIONCORE_WORK_DIR=
AIONCORE_LOG_DIR=

# WeChat Pay API v3 (Native QR payment). Private/public keys may be PEM text
# with escaped newlines or base64-encoded PEM. Never expose these as NEXT_PUBLIC_*.
WECHAT_PAY_APP_ID=wx0541b3e2a6d9dff7
WECHAT_PAY_MCH_ID=1682009029
WECHAT_PAY_CERT_SERIAL_NO=6859FC952467F2F55CF5FB61DBCF394C218A082C
WECHAT_PAY_PRIVATE_KEY=
# Prefer an absolute server-side file path over embedding private key contents.
WECHAT_PAY_PRIVATE_KEY_FILE=/opt/officegpt/shared/wechat-pay/apiclient_key.pem
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PLATFORM_PUBLIC_KEY=
WECHAT_PAY_PLATFORM_PUBLIC_KEY_FILE=/opt/officegpt/shared/wechat-pay/wechatpay_platform_cert.pem
WECHAT_PAY_PLATFORM_SERIAL_NO=278B3DD7DF28353AE82CDBEC54B8DE0D97D70C01
WECHAT_PAY_NOTIFY_URL=https://officegoai.com/api/payments/wechat/notify
MONGODB_URI=mongodb://127.0.0.1:27017/officecli_saas
GOTENBERG_URL=http://127.0.0.1:3001
STORAGE_DIR=./storage
