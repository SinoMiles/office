[Unit]
Description=Prompt Hub web service
After=network-online.target mongod.service
Wants=network-online.target
Requires=mongod.service

[Service]
Type=simple
User=prompthub
Group=prompthub
WorkingDirectory=/opt/prompt-hub/current
EnvironmentFile=/opt/prompt-hub/shared/.env.production
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3001
ExecStart=/usr/bin/node .output/server/index.mjs
Restart=always
RestartSec=5
TimeoutStopSec=30
KillMode=mixed
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
